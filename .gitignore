*.pyc
.env
venv/
rag-env/
aider-env/
data/chroma_db/
# ML artifacts — per-city model and schema files (regenerate with: python -m models.train --city <name>)
*.pkl
models/artifacts/**
!models/artifacts/.gitkeep
.vscode/
# Claude Code project-local settings (per-developer, not committed)
.claude/
# NotebookLM PKB sources — local study materials, not for version control
notebooklm/
# Raw Capital Bikeshare quarterly CSVs — large files, regenerate via fetch_dc_weather.py
data/raw/dc/trips/

# Raw Paris annual counter CSVs — large opendata.paris.fr downloads; regenerate via fetch_paris_weather.py
# Script globs all *.csv in data/raw/paris/ — ignore year-prefixed source files, keep intermediate outputs
data/raw/paris/[0-9][0-9][0-9][0-9]*.csv
data/raw/paris/comptage*.csv

# Chicago Divvy quarterly CSVs — large downloads; regenerate via fetch_chicago_weather.py
data/raw/chicago/trips/

# MLflow local tracking directory — created by DRY_RUN runs of retrain_job.py;
# ephemeral SQLite + run-artifact tree, regenerable from any training run. Not for git.
mlruns/

# Raw Seoul OA-15182 annual ZIP attachments — multi-GB downloads; regenerate via fetch_seoul_weather.py
data/raw/seoul/[0-9][0-9][0-9][0-9]*.zip

# Extracted Seoul OA-15182 year CSVs — large per-trip files; regenerate via fetch_seoul_weather.py
# Script globs all [0-9]{4}*.csv in data/raw/seoul/ — ignore year-prefixed source files, keep intermediate outputs
data/raw/seoul/[0-9][0-9][0-9][0-9]*.csv

# internal planning artifacts
docs/superpowers/
